---
import Base from '../layouts/Base.astro';
import { withBase } from '../lib/data';
---

<Base title="Not found">
  <div class="mx-auto max-w-3xl px-4 pt-16">
    <h1 class="text-3xl font-semibold tracking-tight">Page not found</h1>
    <p class="mt-3 text-ink-2">That page does not exist. <a class="text-sea underline" href={withBase('/')}>Back to the map</a>.</p>
  </div>
</Base>
