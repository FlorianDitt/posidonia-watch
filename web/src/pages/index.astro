---
import Base from '../layouts/Base.astro';
import { withBase, fmtDate } from '../lib/data';
import { readMeta, DEFAULT_PARAMS } from '../lib/buildMeta';

const meta = readMeta();
const large = meta?.params?.large_length_m ?? DEFAULT_PARAMS.large_length_m;
const years = [...new Set((meta?.months ?? []).map((m) => m.slice(0, 4)))];
---

<Base app description="Interactive map of boats anchored on protected Posidonia oceanica seagrass across the Mediterranean, from Sentinel-2 satellite detections.">
  <!-- wrapper: maplibre's own CSS sets .maplibregl-map { position: relative }, so positioning lives here -->
  <div class="absolute inset-0">
    <div id="map" class="h-full w-full bg-surface-2" role="region" aria-label="Map of anchoring pressure on Posidonia meadows"></div>
  </div>

  <div id="map-status" class="pointer-events-none absolute inset-0 z-10 flex items-center justify-center p-6" aria-live="polite">
    <p class="rounded-lg bg-surface/90 px-4 py-3 text-sm text-ink-2 shadow">Loading map…</p>
  </div>

  <aside
    id="panel"
    data-open="false"
    aria-label="Map controls and hotspots"
    class="panel absolute z-20 flex flex-col overflow-hidden border border-line bg-surface text-sm shadow-lg
      max-sm:inset-x-0 max-sm:bottom-0 max-sm:rounded-t-2xl max-sm:border-b-0
      sm:left-3 sm:top-3 sm:max-h-[calc(100%-1.5rem)] sm:w-80 sm:rounded-xl"
  >
    <div class="flex items-center gap-1 border-b border-line px-2 py-2">
      <div role="tablist" aria-label="Panel" class="flex flex-1 gap-1">
        <button role="tab" id="tab-layers" aria-controls="pane-layers" aria-selected="true" class="tab">Layers</button>
        <button role="tab" id="tab-hotspots" aria-controls="pane-hotspots" aria-selected="false" class="tab">Hotspots</button>
      </div>
      <button id="panel-toggle" class="rounded-md px-2 py-1 text-ink-2 hover:bg-surface-2 sm:hidden" aria-expanded="false" aria-controls="panel-body">
        <span class="when-closed">Show ▴</span><span class="when-open">Hide ▾</span>
      </button>
    </div>

    <div id="panel-body" class="panel-body min-h-0 flex-1 overflow-y-auto">
      <section id="pane-layers" role="tabpanel" aria-labelledby="tab-layers" class="px-4 pb-4">
        <details class="sec" open>
          <summary><span class="sec-title">Legend</span><span id="sum-metric" class="sec-value">Boats</span><span class="chev" aria-hidden="true">▾</span></summary>
          <div class="sec-body space-y-4">
            <fieldset id="metric-group">
              <legend class="sr-only">Colour hexagons by</legend>
              <div class="grid grid-cols-3 gap-1">
                <label class="seg seg-radio"><input type="radio" name="metric" value="on_posidonia" checked class="sr-only" />Boats</label>
                <label class="seg seg-radio"><input type="radio" name="metric" value="large_on_posidonia" class="sr-only" />Large</label>
                <label class="seg seg-radio"><input type="radio" name="metric" value="density" class="sr-only" />Density</label>
              </div>
            </fieldset>
            <div>
              <h2 class="mb-3 text-sm font-medium leading-snug text-ink" id="legend-title">Legend</h2>
              <div id="legend" class="tabular text-xs text-ink-2"></div>
            </div>
          </div>
        </details>

        <details class="sec">
          <summary><span class="sec-title">Time</span><span id="sum-time" class="sec-value" aria-live="polite">All</span><span class="chev" aria-hidden="true">▾</span></summary>
          <div class="sec-body space-y-4">
            <div>
              <h3 class="sub">Year</h3>
              <div id="year-group" class="grid grid-cols-4 gap-1" role="group" aria-label="Year">
                {['ALL', ...years].map((y) => (
                  <button type="button" data-year={y} aria-pressed={y === 'ALL' ? 'true' : 'false'} class="seg">{y === 'ALL' ? 'All' : y}</button>
                ))}
              </div>
            </div>
            <div>
              <div class="flex items-baseline justify-between gap-2">
                <h3 class="sub">Months</h3>
                <button type="button" id="time-reset" hidden class="text-xs text-sea underline">Show all</button>
              </div>
              <div id="timeline" class="timeline" aria-label="Months: drag across the bars, or use the arrow keys (Shift to extend, Esc to reset)"></div>
            </div>
            <div>
              <h3 class="sub">Season</h3>
              <div class="grid grid-cols-5 gap-1" id="season-group" role="group" aria-label="Season">
                {['ALL', 'DJF', 'MAM', 'JJA', 'SON'].map((s) => (
                  <button type="button" data-season={s} aria-pressed={s === 'ALL' ? 'true' : 'false'} class="seg"
                    title={{ ALL: 'All seasons', DJF: 'Winter: Dec–Feb', MAM: 'Spring: Mar–May', JJA: 'Summer: Jun–Aug', SON: 'Autumn: Sep–Nov' }[s]}>
                    {{ ALL: 'All', DJF: 'Win', MAM: 'Spr', JJA: 'Sum', SON: 'Aut' }[s]}
                  </button>
                ))}
              </div>
            </div>
          </div>
        </details>

        <details class="sec">
          <summary><span class="sec-title">Map layers</span><span class="sec-value"></span><span class="chev" aria-hidden="true">▾</span></summary>
          <fieldset class="sec-body space-y-3">
            <legend class="sr-only">Show on map</legend>
            <label class="flex items-center gap-2"><input type="checkbox" id="toggle-posidonia" checked class="accent-[var(--seagrass)]" />
              <span class="inline-block h-3 w-4 rounded-sm border border-seagrass bg-seagrass/30"></span>
              <span>Seagrass meadows</span></label>
            <label class="flex items-center gap-2"><input type="checkbox" id="toggle-points" checked class="accent-[var(--sea)]" />
              <span class="inline-flex w-4 items-center justify-center gap-0.5"><span class="inline-block h-1.5 w-1.5 rounded-full" style="background:var(--point-small)"></span><span class="inline-block h-2.5 w-2.5 rounded-full" style="background:var(--point-large)"></span></span>
              <span>Single boats <span class="text-xs text-muted">(big dot ≥ {large} m)</span></span></label>
            <p class="text-xs text-muted">Zoom in to see meadows and single boats.</p>
          </fieldset>
        </details>

        <p class="pt-4 text-xs leading-relaxed text-muted">
          Shows anchoring pressure, not proven violations.{' '}
          <a class="text-sea underline" href={withBase('about/')}>How this works</a>
          <span class="mt-1 block tabular">Updated {meta ? fmtDate(meta.generated_at) : '–'}</span>
        </p>
      </section>

      <section id="pane-hotspots" role="tabpanel" aria-labelledby="tab-hotspots" hidden class="p-2">
        <p class="px-2 pb-2 pt-1 text-xs text-muted">Cells with the most boats anchored on Posidonia (all months). Select one to fly there.</p>
        <ol id="hotspot-list" class="space-y-0.5"></ol>
      </section>
    </div>
  </aside>
</Base>

<style>
  .tab {
    border-radius: 0.375rem;
    padding: 0.35rem 0.75rem;
    color: var(--ink-2);
    font-weight: 500;
  }
  .tab[aria-selected='true'] {
    background: var(--seagrass-soft);
    color: var(--ink);
  }
  .tab:hover { color: var(--ink); }
  .seg {
    border: 1px solid var(--line);
    border-radius: 0.375rem;
    padding: 0.3rem 0;
    font-size: 0.75rem;
    font-weight: 500;
    color: var(--ink-2);
    background: var(--surface);
  }
  .seg[aria-pressed='true'] {
    background: var(--sea);
    border-color: var(--sea);
    color: var(--surface);
  }
  .seg:disabled { opacity: 0.5; }
  .seg-radio {
    display: flex;
    cursor: pointer;
    justify-content: center;
    padding: 0.4rem 0;
    font-size: 0.8125rem;
  }
  .seg-radio:has(input:checked) {
    background: var(--sea);
    border-color: var(--sea);
    color: var(--surface);
  }
  .seg-radio:has(input:focus-visible) {
    outline: 2px solid var(--focus);
    outline-offset: 2px;
  }
  /* Timeline bars are rendered by src/lib/timeline.ts, hence :global() */
  .timeline :global(.tl-bars) {
    display: flex;
    gap: 1px;
    height: 2.75rem;
    cursor: crosshair;
    touch-action: none;
    user-select: none;
    border-radius: 0.25rem;
  }
  .timeline :global(.tl-bars:focus-visible) { outline: 2px solid var(--focus); outline-offset: 3px; }
  .timeline :global(.tl-bars[aria-disabled]) { cursor: default; }
  .timeline :global(.tl-bar) { display: flex; flex: 1 1 0; min-width: 0; align-items: flex-end; }
  .timeline :global(.tl-bar span) {
    display: block;
    width: 100%;
    border-radius: 1px 1px 0 0;
    background: color-mix(in srgb, var(--muted) 40%, transparent);
    transition: background-color 0.1s;
  }
  .timeline :global(.tl-bar.tl-on span) { background: var(--sea); }
  .timeline :global(.tl-bar.tl-missing span) {
    height: 2px;
    background: repeating-linear-gradient(90deg, var(--line) 0 2px, transparent 2px 4px);
  }
  .timeline :global(.tl-axis) { position: relative; height: 1rem; margin-top: 0.25rem; font-size: 10px; color: var(--muted); }
  .timeline :global(.tl-axis span) { position: absolute; top: 0; line-height: 1rem; white-space: nowrap; }
  /* Collapsible panel sections; several can be open at once. */
  .sec { border-bottom: 1px solid var(--line); }
  .sec summary {
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
    padding: 0.8rem 0;
    cursor: pointer;
    list-style: none;
  }
  .sec summary::-webkit-details-marker { display: none; }
  .sec summary:focus-visible { outline: 2px solid var(--focus); outline-offset: 2px; border-radius: 0.25rem; }
  .sec-title { font-size: 0.75rem; font-weight: 600; letter-spacing: 0.04em; text-transform: uppercase; color: var(--muted); }
  .sec summary:hover .sec-title { color: var(--ink); }
  .sec-value { min-width: 0; flex: 1; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; text-align: right; font-size: 0.8125rem; color: var(--ink); }
  .sec-body { padding-bottom: 1rem; }
  .sub { margin-bottom: 0.5rem; font-size: 0.75rem; color: var(--muted); }
  .chev { font-size: 0.7rem; color: var(--muted); transition: transform 0.15s; }
  .sec[open] .chev { transform: rotate(180deg); }
  #metric-group:disabled { opacity: 0.55; }
  .when-open { display: none; }
  .panel[data-open='true'] .when-open { display: inline; }
  .panel[data-open='true'] .when-closed { display: none; }
  @media (max-width: 639.98px) {
    .panel .panel-body { display: none; }
    .panel[data-open='true'] .panel-body { display: block; max-height: 60dvh; }
    .panel { padding-bottom: env(safe-area-inset-bottom); }
  }
</style>

<script>
  import { initMap } from '../lib/map';
  initMap();
</script>
