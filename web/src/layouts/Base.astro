---
import '../styles/global.css';
import { withBase, fmtDate } from '../lib/data';
import { readMeta, isFixture } from '../lib/buildMeta';

interface Props {
  title?: string;
  description?: string;
  /** Map page: full-viewport app layout, footer content moves into the map UI. */
  app?: boolean;
}

const {
  title,
  description = 'Mapping boats anchored on protected Posidonia oceanica seagrass meadows across the Mediterranean, from Sentinel-2 satellite vessel detections and EMODnet seagrass maps.',
  app = false,
} = Astro.props;

const siteName = 'posidonia-watch';
const fullTitle = title ? `${title} · ${siteName}` : `${siteName} – boats anchored on Mediterranean seagrass`;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImage = new URL(withBase('og-image.png'), Astro.site).href;
const meta = readMeta();
const fixture = isFixture(meta);
const repo = 'https://github.com/FlorianDitt/posidonia-watch';

const nav = [
  { href: withBase('/'), label: 'Map', match: (p: string) => p === withBase('/') },
  { href: withBase('trends/'), label: 'Trends', match: (p: string) => p.startsWith(withBase('trends')) },
  { href: withBase('about/'), label: 'About', match: (p: string) => p.startsWith(withBase('about')) },
];
const path = Astro.url.pathname;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href={withBase('favicon.svg')} />
    <meta name="theme-color" content="#f6f7f4" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0d1719" media="(prefers-color-scheme: dark)" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <script is:inline>
      // before first paint, so a stored theme doesn't flash the system one (see lib/theme.ts)
      try {
        const t = localStorage.getItem('theme');
        if (t === 'light' || t === 'dark') document.documentElement.dataset.theme = t;
      } catch {}
    </script>
    <slot name="head" />
  </head>
  <body class:list={['antialiased', app ? 'h-dvh overflow-hidden flex flex-col' : 'min-h-dvh flex flex-col']}>
    <a href="#main" class="sr-only focus:not-sr-only focus:absolute focus:z-50 focus:m-2 focus:rounded focus:bg-surface focus:px-3 focus:py-2">Skip to content</a>
    <header class="z-20 shrink-0 border-b border-line bg-surface/95 backdrop-blur">
      <div class:list={['mx-auto flex h-14 items-center gap-4 px-4', app ? 'max-w-none' : 'max-w-5xl']}>
        <a href={withBase('/')} class="flex shrink-0 items-center gap-2 whitespace-nowrap font-semibold tracking-tight text-ink">
          <img src={withBase('favicon.svg')} alt="" width="26" height="26" />
          <span>posidonia<span class="text-seagrass">-watch</span></span>
        </a>
        <nav aria-label="Main" class="ml-auto flex items-center gap-0.5 text-sm sm:gap-1">
          {nav.map((n) => (
            <a
              href={n.href}
              aria-current={n.match(path) ? 'page' : undefined}
              class:list={[
                'rounded-md px-2.5 py-1.5 transition-colors sm:px-3',
                n.match(path) ? 'bg-seagrass-soft text-ink font-medium' : 'text-ink-2 hover:bg-surface-2 hover:text-ink',
              ]}
            >{n.label}</a>
          ))}
          <a href={repo} class="ml-1 hidden rounded-md px-3 py-1.5 text-ink-2 hover:bg-surface-2 hover:text-ink sm:inline" rel="noopener">GitHub</a>
          <button type="button" id="theme-toggle" class="ml-0.5 rounded-md p-1.5 text-ink-2 hover:bg-surface-2 hover:text-ink" aria-label="Theme">
            <svg data-icon="system" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="4" width="18" height="12" rx="2"/><path d="M8 20h8M12 16v4"/></svg>
            <svg data-icon="light" class="hidden" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"/></svg>
            <svg data-icon="dark" class="hidden" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg>
          </button>
        </nav>
      </div>
    </header>
    {fixture && (
      <div role="note" class="shrink-0 bg-amber-100 px-4 py-1 text-center text-xs text-amber-900 dark:bg-amber-950 dark:text-amber-200">
        Showing <strong>synthetic sample data</strong> for development – not real detections.
      </div>
    )}
    <main id="main" class:list={[app ? 'relative min-h-0 flex-1' : 'flex-1']}>
      <slot />
    </main>
    {!app && (
      <footer class="mt-16 border-t border-line bg-surface">
        <div class="mx-auto flex max-w-5xl flex-col gap-2 px-4 py-6 text-xs text-muted sm:flex-row sm:items-start sm:justify-between">
          <p class="max-w-2xl leading-relaxed">
            Vessel detections: <a class="underline" href="https://globalfishingwatch.org/" rel="noopener">Global Fishing Watch</a> (CC0), contains modified Copernicus Sentinel data.
            Seagrass: <a class="underline" href="https://emodnet.ec.europa.eu/en/seabed-habitats" rel="noopener">EMODnet Seabed Habitats</a> (CC BY 4.0).
            Countries: <a class="underline" href="https://www.marineregions.org/" rel="noopener">Flanders Marine Institute</a> (CC BY 4.0).
            Basemap: <a class="underline" href="https://openfreemap.org/" rel="noopener">OpenFreeMap</a> © <a class="underline" href="https://www.openmaptiles.org/" rel="noopener">OpenMapTiles</a>, data © <a class="underline" href="https://www.openstreetmap.org/copyright" rel="noopener">OpenStreetMap</a> contributors.
            Code: <a class="underline" href={repo} rel="noopener">MIT</a>. Data: CC BY 4.0. <a class="underline" href={withBase('about/')}>Full credits and licences</a>.
          </p>
          <p class="shrink-0 tabular">Data updated {meta ? fmtDate(meta.generated_at) : '–'}</p>
        </div>
      </footer>
    )}
    <script>
      import { initThemeToggle } from '../lib/theme';
      initThemeToggle(document.getElementById('theme-toggle') as HTMLButtonElement);
    </script>
  </body>
</html>
